# Copy this file to .env.local and fill it in. .env.local is gitignored: never commit it.
# After changing a value, restart with `npx expo start --clear` (Metro caches the old one otherwise).

# ── The app's variables ─────────────────────────────────────────────────────
# Everything prefixed EXPO_PUBLIC_ is built into the app. Never put a secret in one.

# Which data the app uses: "mock" (built-in sample data, the default) or "real" (the live server).
EXPO_PUBLIC_API_MODE=mock

# Whether the app may change data on the real server: "off" (the default) or "on". Mock mode ignores it.
EXPO_PUBLIC_API_WRITES=off

# The delivery code (OTP): "off", "mock" or "real". Default: "mock" on mock data, "off" on the real server.
# EXPO_PUBLIC_OTP=mock

# The server's address, used in real mode. Default: https://jibex.cloud/
# EXPO_PUBLIC_API_BASE_URL=https://jibex.cloud/

# ── Not part of the app ─────────────────────────────────────────────────────
# Read by scripts only, never by the app. Deliberately not prefixed
# EXPO_PUBLIC_, so they can never end up inside the app.

# A driver test account, for the read-only probes of the live server (`npm run probe:*`).
# JIBEX_TEST_USERNAME=
# JIBEX_TEST_PASSWORD=

# Web app accounts (agency and sender), for the read-only web app tours. Their scripts are not in git.
# JIBEX_AGENCY_USERNAME=
# JIBEX_AGENCY_PASSWORD=
# JIBEX_SENDER_USERNAME=
# JIBEX_SENDER_PASSWORD=
