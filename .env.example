# Copy this file to .env.local (gitignored), fill it in, then restart with `npx expo start --clear`
# (--clear matters: Metro caches the old value otherwise).

# Which backend the app talks to: "mock" (built-in sample data, the default) or "real".
EXPO_PUBLIC_API_MODE=mock

# Whether real mode may CHANGE server data: "off" (the default) or "on".
# Off: the app reads the real server, but every action that would write to it
# (confirm a run, delivered/failed, pickups, returns, transfers, read receipts)
# shows "Not connected to the server yet" and changes nothing. Mock mode ignores it.
EXPO_PUBLIC_API_WRITES=off

# Optional: point at another server instead of https://jibex.cloud/
# EXPO_PUBLIC_API_BASE_URL=https://jibex.cloud/

# Only for `npm run probe:login`, which checks the real login response.
# Deliberately NOT prefixed EXPO_PUBLIC_, so they can never end up inside the app.
# JIBEX_TEST_USERNAME=
# JIBEX_TEST_PASSWORD=
