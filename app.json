{
  "expo": {
    "name": "jibex",
    "slug": "jibex",
    "version": "1.0.0",
    "scheme": "jibex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIDesignRequiresCompatibility": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSFaceIDUsageDescription": "Jibex uses Face ID to unlock your driver session, which holds your route and cash totals."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Jibex uses your camera to scan package barcodes and capture delivery photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jibex uses your location to show your current zone on the Home screen and to track your route while on shift."
        }
      ],
      "expo-notifications",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Jibex uses Face ID to unlock your driver session, which holds your route and cash totals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
